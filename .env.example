# Copiar a .env y completar. .env NO se versiona. Los nombres coinciden con infra/terraform y la matriz de despliegue.
GCP_PROJECT_ID=tu-proyecto-gcp
GCP_REGION=us-central1
GCS_RAW_BUCKET=tu-proyecto-gcp-retail-raw
GCS_LAKE_BUCKET=tu-proyecto-gcp-retail-lake
PUBSUB_TOPIC=retail-events
LOCAL_RAW_DIR=data/raw

# API local (en Cloud Run estas llegan desde Terraform/Secret Manager)
DATABASE_URL=sqlite:///./data/retail_demo.db
ADMIN_TOKEN=cambia-este-token
ASSISTANT_MODE=rules            # gemini = Vertex AI (requiere gcloud auth application-default login)
GEMINI_MODEL=gemini-2.5-flash-lite
PRICE_DEMO_FACTOR=500           # precio demo = precio normalizado H&M x factor (sintético)
IMAGES_DIR=data/raw/images

# Replay streaming: transacciones 2018-2020 se publican con event_time 2026
REPLAY_TARGET_START=2026-11-01
REPLAY_EVENTS_PER_SEC=50
