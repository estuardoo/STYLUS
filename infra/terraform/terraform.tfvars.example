project_id         = "tu-proyecto-gcp"
region             = "us-central1"
env                = "dev"
billing_account    = ""  # XXXXXX-XXXXXX-XXXXXX para activar alertas de presupuesto
monthly_budget_usd = 50

enable_cloudsql   = true # false = sin base transaccional (ahorra ~USD 8-11/mes)
cloudsql_tier     = "db-f1-micro"
enable_cloud_run  = true
api_public        = true
assistant_mode    = "gemini" # "rules" = sin Vertex AI
github_repo       = ""       # owner/repo para desplegar desde GitHub Actions
