{
  "api_env": {
    "ASSISTANT_MODE": "gemini",
    "DEMO_TOPUP_MAX_CENTS": "50000",
    "GEMINI_LOCATION": "us-central1",
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    "PRICE_DEMO_FACTOR": "500"
  },
  "apis": [
    "aiplatform.googleapis.com",
    "artifactregistry.googleapis.com",
    "bigquery.googleapis.com",
    "billingbudgets.googleapis.com",
    "cloudbilling.googleapis.com",
    "cloudbuild.googleapis.com",
    "cloudresourcemanager.googleapis.com",
    "compute.googleapis.com",
    "dataflow.googleapis.com",
    "dataproc.googleapis.com",
    "iam.googleapis.com",
    "iamcredentials.googleapis.com",
    "logging.googleapis.com",
    "monitoring.googleapis.com",
    "pubsub.googleapis.com",
    "run.googleapis.com",
    "secretmanager.googleapis.com",
    "serviceusage.googleapis.com",
    "sqladmin.googleapis.com",
    "storage.googleapis.com",
    "sts.googleapis.com"
  ],
  "artifact_repo": "retail",
  "billing_account": "",
  "buckets": {
    "lake": "tu-proyecto-gcp-retail-lake",
    "raw": "tu-proyecto-gcp-retail-raw"
  },
  "budget_thresholds": [
    0.5,
    0.9,
    1.0
  ],
  "budget_topic": "billing-budget-alerts",
  "cloudrun": {
    "cpu": "1",
    "enabled": true,
    "image": "us-docker.pkg.dev/cloudrun/container/hello",
    "max_instances": 3,
    "memory": "512Mi",
    "min_instances": 0,
    "public": true,
    "service": "retail-api"
  },
  "cloudsql": {
    "backup_start": "06:00",
    "db_name": "retail",
    "deletion_protection": false,
    "disk_gb": 10,
    "enabled": true,
    "ha": false,
    "instance": "retail-pg",
    "tier": "db-f1-micro",
    "user": "retail_app",
    "version": "POSTGRES_15"
  },
  "datasets": {
    "bronze": {
      "dataset_id": "retail_bronze",
      "delete_contents_on_destroy": true,
      "description": "Datos crudos H&M (tablas externas y nativa) y eventos sin procesar"
    },
    "gold": {
      "dataset_id": "retail_gold",
      "delete_contents_on_destroy": true,
      "description": "Modelo estrella, recomendador y vistas para tableros"
    },
    "ops": {
      "dataset_id": "retail_ops",
      "delete_contents_on_destroy": true,
      "description": "Operación: métricas de streaming, DLQ y costos"
    },
    "silver": {
      "dataset_id": "retail_silver",
      "delete_contents_on_destroy": true,
      "description": "Datos limpios y validados (Parquet cargado) y eventos deduplicados"
    }
  },
  "env": "dev",
  "force_destroy_buckets": false,
  "github": {
    "deployer_key": "deployer",
    "pool_id": "github-dev",
    "repo": ""
  },
  "iam": [
    {
      "member": "sa:ingest",
      "role": "roles/storage.objectAdmin",
      "scope": "bucket:raw"
    },
    {
      "member": "sa:ingest",
      "role": "roles/pubsub.publisher",
      "scope": "topic:events"
    },
    {
      "member": "sa:pipeline",
      "role": "roles/dataproc.worker",
      "scope": "project"
    },
    {
      "member": "sa:pipeline",
      "role": "roles/dataflow.worker",
      "scope": "project"
    },
    {
      "member": "sa:pipeline",
      "role": "roles/bigquery.jobUser",
      "scope": "project"
    },
    {
      "member": "sa:pipeline",
      "role": "roles/storage.objectViewer",
      "scope": "bucket:raw"
    },
    {
      "member": "sa:pipeline",
      "role": "roles/storage.objectAdmin",
      "scope": "bucket:lake"
    },
    {
      "member": "sa:pipeline",
      "role": "roles/bigquery.dataEditor",
      "scope": "dataset:silver"
    },
    {
      "member": "sa:pipeline",
      "role": "roles/bigquery.dataEditor",
      "scope": "dataset:gold"
    },
    {
      "member": "sa:pipeline",
      "role": "roles/bigquery.dataEditor",
      "scope": "dataset:ops"
    },
    {
      "member": "sa:pipeline",
      "role": "roles/pubsub.subscriber",
      "scope": "subscription:dataflow"
    },
    {
      "member": "sa:pipeline",
      "role": "roles/pubsub.viewer",
      "scope": "subscription:dataflow"
    },
    {
      "member": "sa:api",
      "role": "roles/bigquery.jobUser",
      "scope": "project"
    },
    {
      "member": "sa:api",
      "role": "roles/bigquery.dataViewer",
      "scope": "dataset:gold"
    },
    {
      "member": "sa:api",
      "role": "roles/aiplatform.user",
      "scope": "project"
    },
    {
      "member": "sa:api",
      "role": "roles/cloudsql.client",
      "scope": "project"
    },
    {
      "member": "sa:api",
      "role": "roles/secretmanager.secretAccessor",
      "scope": "project"
    },
    {
      "member": "sa:api",
      "role": "roles/pubsub.publisher",
      "scope": "topic:events"
    },
    {
      "member": "sa:api",
      "role": "roles/storage.objectViewer",
      "scope": "bucket:raw"
    },
    {
      "member": "sa:deployer",
      "role": "roles/run.admin",
      "scope": "project"
    },
    {
      "member": "sa:deployer",
      "role": "roles/artifactregistry.writer",
      "scope": "project"
    },
    {
      "member": "sa:deployer",
      "role": "roles/iam.serviceAccountUser",
      "scope": "sa:api"
    },
    {
      "member": "compute-default",
      "role": "roles/cloudbuild.builds.builder",
      "scope": "project"
    },
    {
      "member": "pubsub-agent",
      "role": "roles/bigquery.dataEditor",
      "scope": "dataset:bronze"
    },
    {
      "member": "pubsub-agent",
      "role": "roles/bigquery.metadataViewer",
      "scope": "dataset:bronze"
    },
    {
      "member": "pubsub-agent",
      "role": "roles/pubsub.publisher",
      "scope": "topic:dlq"
    },
    {
      "member": "pubsub-agent",
      "role": "roles/pubsub.subscriber",
      "scope": "subscription:bq"
    },
    {
      "member": "pubsub-agent",
      "role": "roles/pubsub.subscriber",
      "scope": "subscription:dataflow"
    }
  ],
  "images_nearline_days": 30,
  "labels": {
    "curso": "utec-bigdata",
    "proyecto": "retail-bigdata"
  },
  "monthly_budget_usd": 50,
  "noncurrent_version_days": 30,
  "project_id": "tu-proyecto-gcp",
  "pubsub": {
    "bq_subscription": "retail-events-to-bq",
    "bq_table": "bronze.events_raw",
    "dataflow_subscription": "retail-events-dataflow",
    "dlq_subscription": "retail-events-dlq-sub",
    "dlq_topic": "retail-events-dlq",
    "max_delivery_attempts": 5,
    "retention": "86400s",
    "topic": "retail-events"
  },
  "region": "us-central1",
  "secrets": {
    "admin_token": "retail-admin-token",
    "db_url": "retail-db-url"
  },
  "service_accounts": {
    "api": {
      "account_id": "sa-retail-api",
      "description": "Identidad de Cloud Run (API, web y job de catálogo)",
      "display_name": "Retail API"
    },
    "deployer": {
      "account_id": "sa-retail-deployer",
      "description": "GitHub Actions publica imágenes y despliega Cloud Run",
      "display_name": "Retail deployer"
    },
    "ingest": {
      "account_id": "sa-retail-ingest",
      "description": "Cargas a Bronze y publicación de eventos desde jobs",
      "display_name": "Retail ingesta"
    },
    "pipeline": {
      "account_id": "sa-retail-pipeline",
      "description": "Ejecuta Serverless Spark y Dataflow",
      "display_name": "Retail pipelines"
    }
  },
  "tables": [
    {
      "clustering": [],
      "dataset": "bronze",
      "description": "Eventos tal como llegan por la suscripción Pub/Sub -> BigQuery",
      "partition_field": "publish_time",
      "schema": "[{\"name\": \"subscription_name\", \"type\": \"STRING\", \"mode\": \"NULLABLE\", \"description\": \"\"}, {\"name\": \"message_id\", \"type\": \"STRING\", \"mode\": \"NULLABLE\", \"description\": \"\"}, {\"name\": \"publish_time\", \"type\": \"TIMESTAMP\", \"mode\": \"NULLABLE\", \"description\": \"\"}, {\"name\": \"data\", \"type\": \"STRING\", \"mode\": \"NULLABLE\", \"description\": \"JSON del evento\"}, {\"name\": \"attributes\", \"type\": \"STRING\", \"mode\": \"NULLABLE\", \"description\": \"\"}]",
      "table_id": "events_raw"
    },
    {
      "clustering": [],
      "dataset": "ops",
      "description": "Métricas de Dataflow por minuto",
      "partition_field": "window_start",
      "schema": "[{\"name\": \"window_start\", \"type\": \"TIMESTAMP\", \"mode\": \"NULLABLE\", \"description\": \"\"}, {\"name\": \"window_end\", \"type\": \"TIMESTAMP\", \"mode\": \"NULLABLE\", \"description\": \"\"}, {\"name\": \"eventos\", \"type\": \"INTEGER\", \"mode\": \"NULLABLE\", \"description\": \"\"}, {\"name\": \"compras\", \"type\": \"INTEGER\", \"mode\": \"NULLABLE\", \"description\": \"\"}, {\"name\": \"importe\", \"type\": \"FLOAT\", \"mode\": \"NULLABLE\", \"description\": \"\"}, {\"name\": \"lag_p50_s\", \"type\": \"FLOAT\", \"mode\": \"NULLABLE\", \"description\": \"\"}, {\"name\": \"lag_p95_s\", \"type\": \"FLOAT\", \"mode\": \"NULLABLE\", \"description\": \"\"}, {\"name\": \"emitido\", \"type\": \"TIMESTAMP\", \"mode\": \"NULLABLE\", \"description\": \"\"}]",
      "table_id": "stream_metrics_1m"
    },
    {
      "clustering": [],
      "dataset": "ops",
      "description": "Mensajes inválidos rechazados por Dataflow",
      "partition_field": "recibido",
      "schema": "[{\"name\": \"recibido\", \"type\": \"TIMESTAMP\", \"mode\": \"NULLABLE\", \"description\": \"\"}, {\"name\": \"error\", \"type\": \"STRING\", \"mode\": \"NULLABLE\", \"description\": \"\"}, {\"name\": \"payload\", \"type\": \"STRING\", \"mode\": \"NULLABLE\", \"description\": \"\"}]",
      "table_id": "stream_dlq"
    }
  ]
}
